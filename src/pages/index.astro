---
import Layout from "@/layouts/Layout.astro";
import Hero from "@/components/Hero.astro";
import { App } from "@/components/react/App";
---

<Layout
	title="Recaudio Sampler"
	description="Grabá comandos de voz en WAV 16 kHz mono para command-voice. Sesión reanudable."
>
	<main>
		<Hero />
		{/* One island + stable shell in SSR avoids the “components pop in” jump */}
		<App client:load />
	</main>
</Layout>
